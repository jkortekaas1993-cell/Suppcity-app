# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app:
# they must be PUBLIC tokens only (Storefront public token, Supabase anon key).
# Never put Admin API tokens or the Supabase service_role key here.

EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=suppcity.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=replace-with-public-storefront-token
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
