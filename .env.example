# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app:
# they must be PUBLIC tokens only (Storefront public token, Supabase anon key).
# Never put Admin API tokens or the Supabase service_role key here.

EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=suppcity.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=replace-with-public-storefront-token
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Shopify Customer Account API (Headless channel > Customer Account API, public mobile client).
# Client id is public by design (PKCE, no secret). Shop id is the number in the
# callback scheme shop.<SHOP_ID>.app (also add that scheme to app.json "scheme").
EXPO_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace-with-public-client-id
EXPO_PUBLIC_SHOPIFY_SHOP_ID=replace-with-numeric-shop-id
# Optional: discount code shown once in the app's welcome card and applied to new carts.
EXPO_PUBLIC_SHOPIFY_APP_DISCOUNT_CODE=
