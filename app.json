{
  "expo": {
    "name": "Supp City",
    "slug": "suppcity-app",
    "scheme": "suppcity",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "nl.suppcity.app",
      "supportsTablet": false
    },
    "android": {
      "package": "nl.suppcity.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#5CE1E6"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#14D7D1"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070809"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "e1e60754-e445-433b-9b26-d41772d4f266"
      }
    },
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#070809"
  }
}
